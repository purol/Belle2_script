clear all
format long

% Kaon ID
KIDfileID = fopen('KID_toys.txt','r');
formatSpec = '%f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f ';
sizeK = [105 Inf];
KaonMatrix = fscanf(KIDfileID,formatSpec,sizeK);
KaonMatrix = KaonMatrix';
CovKaonID = cov(KaonMatrix)
fclose(KIDfileID);

[Kaoncoeff,Kaonlatent] = pcacov(CovKaonID);
Kaoncoeff*diag(Kaonlatent)*Kaoncoeff';
Kaon_eigen_vector1 = Kaoncoeff(:,1);
Kaon_eigen_vector2 = Kaoncoeff(:,2);
Kaon_eigen_vector3 = Kaoncoeff(:,3);
Kaon_eigen_vector4 = Kaoncoeff(:,4);
Kaon_eigen_vector5 = Kaoncoeff(:,5);
Kaon_eigen_vector6 = Kaoncoeff(:,6);
Kaon_eigen_vector7 = Kaoncoeff(:,7);
Kaon_eigen_vector8 = Kaoncoeff(:,8);
Kaon_eigen_vector9 = Kaoncoeff(:,9);
Kaon_eigen_value1 = sqrt(Kaonlatent(1));
Kaon_eigen_value2 = sqrt(Kaonlatent(2));
Kaon_eigen_value3 = sqrt(Kaonlatent(3));
Kaon_eigen_value4 = sqrt(Kaonlatent(4));
Kaon_eigen_value5 = sqrt(Kaonlatent(5));
Kaon_eigen_value6 = sqrt(Kaonlatent(6));
Kaon_eigen_value7 = sqrt(Kaonlatent(7));
Kaon_eigen_value8 = sqrt(Kaonlatent(8));
Kaon_eigen_value9 = sqrt(Kaonlatent(9));
Kaoncoeff(:,1) = 0;
Kaoncoeff(:,2) = 0;
Kaoncoeff(:,3) = 0;
Kaoncoeff(:,4) = 0;
Kaoncoeff(:,5) = 0;
Kaoncoeff(:,6) = 0;
Kaoncoeff(:,7) = 0;
Kaoncoeff(:,8) = 0;
Kaoncoeff(:,9) = 0;
Kaonlatent(1) = 0;
Kaonlatent(2) = 0;
Kaonlatent(3) = 0;
Kaonlatent(4) = 0;
Kaonlatent(5) = 0;
Kaonlatent(6) = 0;
Kaonlatent(7) = 0;
Kaonlatent(8) = 0;
Kaonlatent(9) = 0;
%Kaon_eigen_remain = diag(Kaonlatent);
Kaonpartialcov = Kaon_eigen_vector1*Kaon_eigen_value1*Kaon_eigen_value1*Kaon_eigen_vector1'+...
    Kaon_eigen_vector2*Kaon_eigen_value2*Kaon_eigen_value2*Kaon_eigen_vector2'+...
    Kaon_eigen_vector3*Kaon_eigen_value3*Kaon_eigen_value3*Kaon_eigen_vector3'+...
    Kaon_eigen_vector4*Kaon_eigen_value4*Kaon_eigen_value4*Kaon_eigen_vector4'+...
    Kaon_eigen_vector5*Kaon_eigen_value5*Kaon_eigen_value5*Kaon_eigen_vector5'+...
        Kaon_eigen_vector5*Kaon_eigen_value5*Kaon_eigen_value5*Kaon_eigen_vector5'+...
            Kaon_eigen_vector5*Kaon_eigen_value5*Kaon_eigen_value5*Kaon_eigen_vector5'+...
                Kaon_eigen_vector5*Kaon_eigen_value5*Kaon_eigen_value5*Kaon_eigen_vector5'+...
                    Kaon_eigen_vector5*Kaon_eigen_value5*Kaon_eigen_value5*Kaon_eigen_vector5'+...
    ;

CorrKaonID = corrcov(CovKaonID);
Kaonpartialcorr = corrcov(Kaonpartialcov);

% print KID info into file
KIDfileID_w = fopen('KID_selected.txt','w');
fprintf(KIDfileID_w,"%1.15f\n",Kaon_eigen_value1);
for i = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaon_eigen_vector1(i));
end
fprintf(KIDfileID_w,"\n");

fprintf(KIDfileID_w,"%1.15f\n",Kaon_eigen_value2);
for i = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaon_eigen_vector2(i));
end
fprintf(KIDfileID_w,"\n");

fprintf(KIDfileID_w,"%1.15f\n",Kaon_eigen_value3);
for i = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaon_eigen_vector3(i));
end
fprintf(KIDfileID_w,"\n");

fprintf(KIDfileID_w,"%1.15f\n",Kaon_eigen_value4);
for i = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaon_eigen_vector4(i));
end
fprintf(KIDfileID_w,"\n");

fprintf(KIDfileID_w,"%1.15f\n",Kaon_eigen_value5);
for i = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaon_eigen_vector5(i));
end
fprintf(KIDfileID_w,"\n");

fclose(KIDfileID_w);

KIDfileID_w = fopen('KID_cov_all.txt','w');
for i = 1:105
    for j = 1:105
        fprintf(KIDfileID_w,"%1.15f ",CovKaonID(i,j));
    end
    fprintf(KIDfileID_w,"\n");
end
fclose(KIDfileID_w);

KIDfileID_w = fopen('KID_cov_partial.txt','w');
for i = 1:105
    for j = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaonpartialcov(i,j));
    end
    fprintf(KIDfileID_w,"\n");
end
fclose(KIDfileID_w);

KIDfileID_w = fopen('KID_corr_all.txt','w');
for i = 1:105
    for j = 1:105
        fprintf(KIDfileID_w,"%1.15f ",CorrKaonID(i,j));
    end
    fprintf(KIDfileID_w,"\n");
end
fclose(KIDfileID_w);

KIDfileID_w = fopen('KID_corr_partial.txt','w');
for i = 1:105
    for j = 1:105
        fprintf(KIDfileID_w,"%1.15f ",Kaonpartialcorr(i,j));
    end
    fprintf(KIDfileID_w,"\n");
end
fclose(KIDfileID_w);

% Pion ID
PIDfileID = fopen('PID_toys.txt','r');
formatSpec = '%f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f %f ';
sizeP = [105 Inf];
PionMatrix = fscanf(PIDfileID,formatSpec,sizeP);
PionMatrix = PionMatrix';
CovPionID = cov(PionMatrix);
fclose(PIDfileID);

[Pioncoeff,Pionlatent] = pcacov(CovPionID);
Pion_eigen_vector1 = Pioncoeff(:,1)
Pion_eigen_vector2 = Pioncoeff(:,2)
Pion_eigen_vector3 = Pioncoeff(:,3)
Pion_eigen_value1 = sqrt(Pionlatent(1))
Pion_eigen_value2 = sqrt(Pionlatent(2))
Pion_eigen_value3 = sqrt(Pionlatent(3))

% latent: eigen value
% coeff: eigen vector